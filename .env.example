# =============================================================================
# UPIAN Platform Environment Configuration (.env.example)
# All secret API keys MUST remain empty by default.
# Never commit real API keys to version control.
# =============================================================================

# ---------- Flask Configuration ----------
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
HOST=127.0.0.1
PORT=5000
APP_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false

# ---------- PostgreSQL Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upian_full_project

# ---------- Initial Admin Account ----------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@upian.local
ADMIN_PASSWORD=ChangeMe@12345

# ---------- Text Generation Keys (Optional - Keep empty by default) ----------
# Provider slots: gemini | openai | anthropic
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MEDIUM_MODEL=gemini-3.8-flash
GEMINI_COMPLEX_MODEL=gemini-3.8-pro

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=

STRONG_1_PROVIDER=gemini
STRONG_1_API_KEY=
STRONG_1_MODEL=
STRONG_1_BASE_URL=

STRONG_2_PROVIDER=openai
STRONG_2_API_KEY=
STRONG_2_MODEL=
STRONG_2_BASE_URL=

WEAK_1_PROVIDER=gemini
WEAK_1_API_KEY=
WEAK_1_MODEL=
WEAK_1_BASE_URL=

WEAK_2_PROVIDER=openai
WEAK_2_API_KEY=
WEAK_2_MODEL=
WEAK_2_BASE_URL=

# ---------- Image Generation Keys (Strictly separate from Text Keys) ----------
# NEVER use text generation keys for image generation.
IMAGE_GEN_API_KEY=
IMAGE_GEN_PROVIDER=mock
IMAGE_GEN_LOW_MODEL=dall-e-2
IMAGE_GEN_PREMIUM_MODEL=dall-e-3
STABILITY_API_KEY=

# Image quotas per plan
FREE_IMAGE_GEN=false
FREE_IMAGE_DAILY=0
PLUS_IMAGE_DAILY=20
PRO_IMAGE_DAILY=30

# ---------- Query Classifier & Complexity Routing ----------
QWEN_MODEL_PATH=./models/Qwen3-Embedding-0.6B
USE_EMBEDDINGS=false
CLASSIFIER_THRESHOLD=0.5
CLASSIFIER_DEVICE=cpu
ROUTING_PREFERENCE=auto
COMPLEXITY_SIMPLE_MAX=0.35
COMPLEXITY_COMPLEX_MIN=0.70

# ---------- Vision / Multimodal (Local Ollama / CPU) ----------
VISION_QWEN_3B_BASE_URL=http://localhost:11434/v1
VISION_QWEN_3B_MODEL=qwen2.5-vl:3b
VISION_QWEN_3B_API_KEY=
VISION_DEVICE=cpu

# ---------- Payment Gateway (Optional) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# ---------- Google OAuth (Optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=upian-515405
GOOGLE_REDIRECT_URI=
